{
  "name": "apex-docx-pdf",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run docs:check && bun run build && bun run packages:validate",
    "dev": "turbo dev",
    "convex:codegen": "convex codegen",
    "convex:dev": "convex dev",
    "convex:typecheck": "tsc -p convex/tsconfig.json --noEmit",
    "docs:check": "bun run --cwd docs check",
    "docs:dev": "bun run --cwd docs dev",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "format": "turbo format",
    "format:check": "prettier --check .",
    "packages:check": "bun run build && bun run packages:validate",
    "packages:validate": "bun scripts/check-packages.ts",
    "release:version": "changeset version",
    "test": "bun test",
    "typecheck": "turbo typecheck && bun run convex:typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.7",
    "@changesets/cli": "2.31.1",
    "@types/bun": "^1.3.14",
    "convex-test": "^0.0.55",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "publint": "0.3.23",
    "tsup": "8.5.1",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "docs",
    "packages/*"
  ],
  "dependencies": {
    "convex": "1.43.0",
    "convex-helpers": "0.1.122"
  }
}
