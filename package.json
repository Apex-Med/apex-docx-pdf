{
  "name": "apex-docx-pdf",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "docs:check": "bun run --cwd docs check",
    "docs:dev": "bun run --cwd docs dev",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "format": "turbo format",
    "format:check": "prettier --check .",
    "test": "bun test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "^1.3.14",
    "convex-test": "^0.0.55",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "docs",
    "packages/*"
  ]
}
