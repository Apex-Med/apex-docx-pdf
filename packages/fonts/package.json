{
  "name": "@apexmed/fonts",
  "version": "0.1.0-next.1",
  "description": "Explicit font registration and shaping adapters for Apex DOCX PDF.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craig-bredenkamp/apex-docx-pdf.git",
    "directory": "packages/fonts"
  },
  "homepage": "https://github.com/craig-bredenkamp/apex-docx-pdf#readme",
  "bugs": {
    "url": "https://github.com/craig-bredenkamp/apex-docx-pdf/issues"
  },
  "keywords": [
    "fonts",
    "fontkit",
    "pdf",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "assets"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && bun ../../scripts/prepare-package.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apexmed/core": "workspace:*",
    "fontkit": "2.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "notosans-fontface": "1.3.0",
    "typescript": "^6"
  }
}
