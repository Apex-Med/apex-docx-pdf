{
  "name": "apex-docx-pdf",
  "version": "0.1.0-next.0",
  "description": "Deterministic, Bun-first DOCX template to PDF rendering for TypeScript.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craig-bredenkamp/apex-docx-pdf.git",
    "directory": "packages/apex-docx-pdf"
  },
  "homepage": "https://github.com/craig-bredenkamp/apex-docx-pdf#readme",
  "bugs": {
    "url": "https://github.com/craig-bredenkamp/apex-docx-pdf/issues"
  },
  "keywords": [
    "docx",
    "pdf",
    "templates",
    "typescript",
    "bun"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && bun ../../scripts/prepare-package.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apex-docx-pdf/core": "workspace:*",
    "@apex-docx-pdf/engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6"
  }
}
