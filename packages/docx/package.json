{
  "name": "@apexmed/docx",
  "version": "0.1.0-next.0",
  "description": "Bounded DOCX package validation, parsing, and normalization for Apex DOCX PDF.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craig-bredenkamp/apex-docx-pdf.git",
    "directory": "packages/docx"
  },
  "homepage": "https://github.com/craig-bredenkamp/apex-docx-pdf#readme",
  "bugs": {
    "url": "https://github.com/craig-bredenkamp/apex-docx-pdf/issues"
  },
  "keywords": [
    "docx",
    "ooxml",
    "parser",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && bun ../../scripts/prepare-package.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apexmed/core": "workspace:*",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "typescript": "^6"
  }
}
