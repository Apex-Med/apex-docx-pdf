{
  "name": "@apex-docx-pdf/engine",
  "version": "0.1.0-next.0",
  "description": "The deterministic DOCX-to-PDF orchestration engine for Apex DOCX PDF.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craig-bredenkamp/apex-docx-pdf.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/craig-bredenkamp/apex-docx-pdf#readme",
  "bugs": {
    "url": "https://github.com/craig-bredenkamp/apex-docx-pdf/issues"
  },
  "keywords": [
    "docx",
    "pdf",
    "renderer",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && bun ../../scripts/prepare-package.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apex-docx-pdf/core": "workspace:*",
    "@apex-docx-pdf/docx": "workspace:*",
    "@apex-docx-pdf/fonts": "workspace:*",
    "@apex-docx-pdf/images": "workspace:*",
    "@apex-docx-pdf/layout": "workspace:*",
    "@apex-docx-pdf/pdf": "workspace:*",
    "@apex-docx-pdf/template": "workspace:*"
  },
  "devDependencies": {
    "@apex-docx-pdf/testkit": "workspace:*",
    "fflate": "^0.8.3",
    "notosans-fontface": "1.3.0",
    "typescript": "^6"
  }
}
