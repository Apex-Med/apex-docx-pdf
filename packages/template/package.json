{
  "name": "@apexmed/template",
  "version": "0.1.0-next.0",
  "description": "Typed, bounded DOCX template compilation and resolution for Apex DOCX PDF.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craig-bredenkamp/apex-docx-pdf.git",
    "directory": "packages/template"
  },
  "homepage": "https://github.com/craig-bredenkamp/apex-docx-pdf#readme",
  "bugs": {
    "url": "https://github.com/craig-bredenkamp/apex-docx-pdf/issues"
  },
  "keywords": [
    "docx",
    "templates",
    "typescript",
    "document-generation"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && bun ../../scripts/prepare-package.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apexmed/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6"
  }
}
